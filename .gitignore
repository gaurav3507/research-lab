# Never commit data or results
results/
data/

# Array / model / tabular blobs
*.npy
*.npz
*.pt
*.pkl
*.h5
*.gz
*.csv
*.tsv

# Python / notebook cruft
__pycache__/
.ipynb_checkpoints/

# Virtual environments
venv/
.venv/
env/
.env/

# park-grass-crl: ignore raw data but keep data/MANIFEST.md and the probe result
# JSONs. The global results/ and data/ rules above exclude the whole directories,
# so the lane directories are re-included first, then only raw data is re-ignored.
!lanes/park-grass-crl/data/
lanes/park-grass-crl/data/*
!lanes/park-grass-crl/data/MANIFEST.md
!lanes/park-grass-crl/results/
!lanes/park-grass-crl/results/**
